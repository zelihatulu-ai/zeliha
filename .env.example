# PostgreSQL / Prisma / Vercel Veritabanı Bağlantısı
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"
POSTGRES_URL="postgres://user:password@host:5432/postgres?sslmode=require"
PRISMA_DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Gemini API Anahtarı (Zorunlu)
# API anahtarınızı Google AI Studio üzerinden edinebilirsiniz: https://aistudio.google.com/app/apikey
# GÜVENLİK NOTU: API anahtarı sadece sunucu tarafında (Server Route / Route Handler) okunmalıdır.
# Kesinlikle 'NEXT_PUBLIC_' öneki KULLANILMAMALIDIR.
GEMINI_API_KEY=your_gemini_api_key_here

# Opsiyonel: Kullanılacak Gemini Model Adı (Varsayılan: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Uygulama URL'si (Opsiyonel)
APP_URL=http://localhost:3000
